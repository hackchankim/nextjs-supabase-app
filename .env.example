# Supabase 환경변수 템플릿
#
# 사용법:
#   1) 복사:  cp .env.example .env.local   (또는 scripts/setup.sh 실행)
#   2) 아래 값을 Supabase 프로젝트 값으로 채운다. (.env.local 은 git 에 커밋되지 않음)
#
# 모든 값은 Supabase 대시보드 → 프로젝트 → Settings → API 에서 확인.
# 기존 anon 키와 새로운 publishable 키 형식 모두 사용 가능.

# 클라이언트/서버 공용 (브라우저 노출 OK)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 — RLS를 우회하는 마스터 키. Server Action/route handler 에서만 사용.
# ⚠️ 절대 NEXT_PUBLIC_ 접두사 금지(브라우저 노출됨)·절대 커밋 금지.
#    게임 로직(닉네임 입장·역할 배분·채팅 등 서버 계층 쓰기)에 필요.
SUPABASE_SERVICE_ROLE_KEY=

# 서버 전용 — 게임 채팅의 개인 인박스(비밀 채널/1:1 귓속말) Broadcast 채널명을
# HMAC 서명하는 데 쓰는 시크릿. 선택값 — 미설정 시 SUPABASE_SERVICE_ROLE_KEY로 폴백한다.
# ⚠️ 절대 NEXT_PUBLIC_ 접두사 금지(브라우저 노출됨)·절대 커밋 금지.
BROADCAST_INBOX_SECRET=

# 서버 전용 — 관리자 패널(/game/manage) 인증용 운영자 전용 시크릿. 진행자 4자리 PIN과는
# 완전히 별개다. 미설정 시 관리자 기능이 전부 잠긴다(fail-safe).
# ⚠️ 절대 NEXT_PUBLIC_ 접두사 금지(브라우저 노출됨)·절대 커밋 금지.
ADMIN_SECRET=
